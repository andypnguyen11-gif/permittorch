# PermitTorch environment template. Copy to `.env` (repo root, git-ignored) and fill in
# real values; `apps/web/.env.local` mirrors the web subset. Never commit real values.
# Load for API/scripts with:  set -a; source .env; set +a

# ── apps/api ────────────────────────────────────────────────
# Postgres connection: postgresql:// URL (Railway form) or Npgsql keyword form both work.
# Matches docker-compose.yml for local dev.
DATABASE_URL=postgresql://permittorch:permittorch@localhost:5432/permittorch
# Apply pending EF Core migrations on boot (Railway deploys set true; tests never do).
RUN_MIGRATIONS_ON_STARTUP=true
# Kestrel bind address. macOS AirPlay Receiver holds :5000, so local dev uses :5050.
ASPNETCORE_URLS=http://localhost:5050
ASPNETCORE_ENVIRONMENT=Development
# Apify: token + the dedicated task scrapelabmax/permittorch-daily (master §9/§10).
# Leave APIFY_TOKEN empty locally to run without ingestion.
APIFY_TOKEN=
APIFY_TASK_ID=xatpyth2FgbUydjLd
# Firebase ID-token validation (project id only; keys come from Google's OIDC discovery)
FIREBASE_PROJECT_ID=permittorch-dev
# Stripe billing — use a restricted rk_test_ key; prices are the monthly plan price ids
STRIPE_SECRET_KEY=rk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_PRICE_STARTER=price_replace
STRIPE_PRICE_PRO=price_replace
STRIPE_PRICE_TERRITORY=price_replace
# Resend digest + transactional email
RESEND_API_KEY=re_replace
EMAIL_FROM=leads@permittorch.dev
# HMAC secret for one-click unsubscribe links (openssl rand -base64 48)
EMAIL_UNSUBSCRIBE_SECRET=replace
# Sentry errors (api)
SENTRY_DSN=
# Web origin: CORS allowed origin + Stripe Checkout success/cancel redirect base
WEB_ORIGIN=http://localhost:3000
# Public base URL of this API (unsubscribe links in emails); required outside Development/Testing
API_PUBLIC_URL=http://localhost:5050
# Optional: trusted proxy hops for X-Forwarded-For (default 1; set 2 only behind a CDN + Railway)
# ForwardedHeaders__ForwardLimit=1
# Optional: false disables ingestion, source-health and rescoring jobs (default true)
# Pipeline__Enabled=true

# ── Seeder / E2E identities (Firebase Auth uids) ────────────
SUPERADMIN_FIREBASE_UID=
SUPERADMIN_EMAIL=e2e-admin@permittorch.dev
E2E_ENTITLED_FIREBASE_UID=
E2E_ENTITLED_EMAIL=e2e-entitled@permittorch.dev
E2E_UNENTITLED_FIREBASE_UID=
E2E_UNENTITLED_EMAIL=e2e-unentitled@permittorch.dev
E2E_USER_PASSWORD=

# ── apps/web (apps/web/.env.local mirrors this subset) ─────
# API client base URL (match ASPNETCORE_URLS above)
NEXT_PUBLIC_API_URL=http://localhost:5050
# 1 serves fixtures instead of calling the API; leave unset for real API integration
# NEXT_PUBLIC_API_MOCK=1
# Mock mode only: MEMBER | ADMIN | SUPER_ADMIN (default SUPER_ADMIN)
# NEXT_PUBLIC_MOCK_ROLE=MEMBER
# Firebase client SDK (browser)
NEXT_PUBLIC_FIREBASE_API_KEY=replace
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=permittorch-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=permittorch-dev
NEXT_PUBLIC_FIREBASE_APP_ID=replace
# next-firebase-auth-edge session cookies (server): service account + rotating signature keys.
# FIREBASE_PROJECT_ID above is shared by the web server.
FIREBASE_CLIENT_EMAIL=replace
# Paste with literal \n sequences
FIREBASE_PRIVATE_KEY=replace
# openssl rand -base64 48 (each). Without them every request is treated as signed out.
AUTH_COOKIE_SIGNATURE_KEY_CURRENT=replace
AUTH_COOKIE_SIGNATURE_KEY_PREVIOUS=replace
# PostHog analytics + Sentry errors (web)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=
