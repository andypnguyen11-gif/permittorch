<Project>
  <!--
    Workaround for a real upstream version skew: Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3
    (pinned in the frozen PermitTorch.Api.csproj) only requires Microsoft.EntityFrameworkCore
    >= 10.0.4, while Microsoft.EntityFrameworkCore.Design 10.0.12 (also pinned there, but marked
    PrivateAssets="all" so its version does not flow to consumers via ProjectReference) forces
    PermitTorch.Api.dll to be built against Microsoft.EntityFrameworkCore 10.0.12. Without this
    pin, this test project's own restore floats Microsoft.EntityFrameworkCore down to 10.0.4,
    causing CS1705 when compiling against PermitTorch.Api.dll. No newer Npgsql.EntityFrameworkCore.PostgreSQL
    10.x patch exists on NuGet to fix this at the source, so this project takes a direct,
    matching pin instead.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>
</Project>
